---
import Base from '../layouts/Base.astro';
---

<Base
  title="Get Your Free AI Automation Blueprint"
  description="Free workflow audit for enterprise leaders. Top 3 AI automation opportunities, ROI estimate, and implementation timeline."
>

  <!-- PAGE HEADER -->
  <section class="section-padding bg-gray-50 border-b border-gray-200">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <div class="text-electric-400 text-sm font-semibold uppercase tracking-wider mb-4">Free Resource</div>
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
          Get Your Free AI Automation Blueprint
        </h1>
        <p class="text-xl text-gray-500 leading-relaxed">
          No commitment. No sales pitch. Just a clear picture of what AI can do
          for your operations — and what it would cost to get there.
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- LEFT: WHAT YOU GET + TRUST -->
        <div class="lg:col-span-2 space-y-8">

          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-6">What You Get</h2>
            <div class="space-y-5">
              {[
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />`,
                  title: 'Workflow Audit',
                  desc: 'A structured review of your current processes — where time is lost, where errors happen, where humans do what software should do.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
                  title: 'Top 3 Automation Opportunities',
                  desc: 'Prioritised by ROI and implementation complexity. We tell you which to tackle first for the fastest, highest-value results.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
                  title: 'ROI Estimate',
                  desc: 'A concrete estimate of cost savings and cycle time reduction for each opportunity. Numbers you can take to your leadership.',
                },
                {
                  icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
                  title: 'Implementation Timeline',
                  desc: 'A realistic 90-day plan for the first automation. Phases, dependencies, and what we need from your team at each stage.',
                },
              ].map((item) => (
                <div class="flex gap-4">
                  <div class="flex-shrink-0 w-10 h-10 bg-electric-500/10 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-electric-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.icon} />
                  </div>
                  <div>
                    <div class="text-gray-900 font-medium text-sm mb-1">{item.title}</div>
                    <div class="text-gray-500 text-sm leading-relaxed">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="card border-electric-500/10 p-6">
            <div class="text-electric-400 text-xs font-semibold uppercase tracking-wider mb-3">Trust</div>
            <div class="space-y-3">
              {[
                'No commitment required after the blueprint',
                'No sales pressure during or after the call',
                'Blueprint delivered within 5 business days',
                'Your data stays with you — nothing is shared',
              ].map((point) => (
                <div class="flex items-start gap-2 text-sm text-gray-500">
                  <svg class="w-4 h-4 text-accent-emerald flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {point}
                </div>
              ))}
            </div>
          </div>

          <div class="text-gray-500 text-xs leading-relaxed">
            We have delivered blueprints for teams across Manufacturing, BFSI, Retail,
            Education, and Healthcare. The audit typically surfaces 2-3 automation opportunities
            with combined annual savings in the Rs 30-80 lakh range.
          </div>

        </div>

        <!-- RIGHT: FORM -->
        <div class="lg:col-span-3">
          <div class="card border-electric-500/10 p-6 sm:p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-6">Request Your Blueprint</h2>

            <form id="blueprint-form" class="space-y-5">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="bp-name" class="block text-sm font-medium text-gray-700 mb-2">
                    Your Name <span class="text-electric-400">*</span>
                  </label>
                  <input
                    type="text"
                    id="bp-name"
                    name="name"
                    required
                    placeholder="Rajesh Kumar"
                    class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="bp-title" class="block text-sm font-medium text-gray-700 mb-2">
                    Your Title <span class="text-electric-400">*</span>
                  </label>
                  <input
                    type="text"
                    id="bp-title"
                    name="title"
                    required
                    placeholder="VP Technology / CTO"
                    class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="bp-company" class="block text-sm font-medium text-gray-700 mb-2">
                  Company Name <span class="text-electric-400">*</span>
                </label>
                <input
                  type="text"
                  id="bp-company"
                  name="companyName"
                  required
                  placeholder="Your Company Ltd."
                  class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                />
              </div>

              <div>
                <label for="bp-revenue" class="block text-sm font-medium text-gray-700 mb-2">
                  Annual Revenue Range <span class="text-electric-400">*</span>
                </label>
                <select
                  id="bp-revenue"
                  name="revenueRange"
                  required
                  class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 text-sm focus:outline-none focus:border-electric-500 transition-colors appearance-none"
                >
                  <option value="" disabled selected class="text-gray-500">Select revenue range</option>
                  <option value="200-500 Cr">Rs 200-500 Crore</option>
                  <option value="500-2000 Cr">Rs 500-2000 Crore</option>
                  <option value="2000+ Cr">Rs 2000+ Crore</option>
                </select>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="bp-email" class="block text-sm font-medium text-gray-700 mb-2">
                    Work Email <span class="text-electric-400">*</span>
                  </label>
                  <input
                    type="email"
                    id="bp-email"
                    name="email"
                    required
                    placeholder="you@company.com"
                    class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="bp-whatsapp" class="block text-sm font-medium text-gray-700 mb-2">
                    WhatsApp Number
                  </label>
                  <input
                    type="tel"
                    id="bp-whatsapp"
                    name="whatsappNumber"
                    placeholder="+91 98765 43210"
                    class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="bp-bottleneck" class="block text-sm font-medium text-gray-700 mb-2">
                  Describe Your Biggest Operational Bottleneck <span class="text-electric-400">*</span>
                </label>
                <textarea
                  id="bp-bottleneck"
                  name="bottleneck"
                  required
                  rows="4"
                  placeholder="What process takes too long, costs too much, or has too many errors? The more specific you are, the more useful the blueprint will be."
                  class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors resize-none"
                ></textarea>
              </div>

              <!-- Messages -->
              <div id="bp-success" class="hidden bg-accent-emerald/10 border border-accent-emerald/30 rounded-lg px-4 py-3 text-accent-emerald text-sm">
                Blueprint request received. We will reach out shortly to schedule the audit call.
              </div>
              <div id="bp-error" class="hidden bg-red-500/10 border border-red-500/30 rounded-lg px-4 py-3 text-red-400 text-sm">
                Something went wrong. Please email us directly at yogesh@anomalies.in
              </div>

              <button
                type="submit"
                id="bp-submit"
                class="btn-primary w-full justify-center text-base py-4"
              >
                <span id="bp-submit-text">Request My Free Blueprint</span>
                <span id="bp-submit-loading" class="hidden">Submitting...</span>
              </button>

              <p class="text-xs text-gray-500 text-center">
                No commitment required. We will reach out to schedule a 30-minute intake call.
              </p>

            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF / PROCESS -->
  <section class="section-padding bg-gray-50 border-t border-gray-200">
    <div class="container-narrow">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">What Happens After You Submit</h2>
        <p class="text-gray-500 text-sm">Simple. Transparent. No surprises.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-6 max-w-3xl mx-auto">
        {[
          { step: '1', title: 'We Review Your Submission', time: 'Same day' },
          { step: '2', title: 'Intake Call Scheduled', time: '30 minutes, your calendar' },
          { step: '3', title: 'We Audit Your Workflows', time: 'We do the work, not you' },
          { step: '4', title: 'Blueprint Delivered', time: 'Within 5 business days' },
        ].map((item) => (
          <div class="text-center">
            <div class="w-10 h-10 bg-electric-500/10 border border-electric-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
              <span class="text-electric-400 text-sm font-bold">{item.step}</span>
            </div>
            <div class="text-gray-900 text-sm font-medium mb-1">{item.title}</div>
            <div class="text-gray-500 text-xs">{item.time}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>

<script>
  const form = document.getElementById('blueprint-form') as HTMLFormElement;
  const submitBtn = document.getElementById('bp-submit') as HTMLButtonElement;
  const submitText = document.getElementById('bp-submit-text') as HTMLElement;
  const submitLoading = document.getElementById('bp-submit-loading') as HTMLElement;
  const successMsg = document.getElementById('bp-success') as HTMLElement;
  const errorMsg = document.getElementById('bp-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    const payload = {
      name: formData.get('name'),
      title: formData.get('title'),
      companyName: formData.get('companyName'),
      revenueRange: formData.get('revenueRange'),
      email: formData.get('email'),
      whatsappNumber: formData.get('whatsappNumber') || '',
      bottleneck: formData.get('bottleneck'),
      source: 'anomalies.in',
      stage: 'blueprint_request',
    };

    submitBtn.disabled = true;
    submitText.classList.add('hidden');
    submitLoading.classList.remove('hidden');
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    try {
      const response = await fetch(
        'https://n8n.srv1148691.hstgr.cloud/webhook/cda2f05a-4f2d-4a33-a636-583eb1cbe76f',
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }
      );

      if (response.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitText.classList.remove('hidden');
      submitLoading.classList.add('hidden');
    }
  });
</script>
