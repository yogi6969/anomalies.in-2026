---
import Base from '../../layouts/Base.astro';

const solutions = [
  {
    title: 'Invoice & Document Automation',
    description: 'AI-powered OCR, classification, and 3-way matching. Process invoices in minutes, not weeks. GST-compliant extraction with automated vendor routing.',
    href: '/solutions/invoice-automation/',
    metrics: ['87% cost reduction', '13x faster processing', '80% labor reduction'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
  },
  {
    title: 'ERP Integration',
    description: 'Connect Oracle EBS, SAP, and Tally to automated workflows. Real-time procurement data pipelines with zero manual extraction.',
    href: '/solutions/erp-integration/',
    metrics: ['Real-time data access', 'Zero manual extraction', '60% maintenance reduction'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`,
  },
  {
    title: 'Agentic AI Workflows',
    description: 'Multi-step autonomous systems for approvals, vendor onboarding, MIS generation, and exception routing — with human-in-the-loop oversight.',
    href: '/solutions/agentic-workflows/',
    metrics: ['Same-day approvals', '3-5 day vendor onboarding', 'Full audit trail'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    title: 'Enterprise AI Chatbots',
    description: 'Teams and WhatsApp bots that answer from YOUR documents. SOPs, policies, PO status — instant, 24/7, no training required.',
    href: '/solutions/enterprise-ai-chatbots/',
    metrics: ['40-60% fewer support tickets', '50%+ support load reduction', '24/7 availability'],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`,
  },
];
---

<Base
  title="AI Automation Solutions for Indian Enterprise"
  description="Invoice automation, ERP integration, agentic workflows, and enterprise chatbots. Production-ready AI systems for enterprise technology teams."
>

  <!-- Breadcrumb -->
  <div class="border-b border-gray-200">
    <div class="container-narrow py-4">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gray-500">Solutions</span>
      </nav>
    </div>
  </div>

  <!-- Header -->
  <section class="section-padding border-b border-gray-200">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
          What We Build
        </h1>
        <p class="text-xl text-gray-500 leading-relaxed">
          Production-ready AI automation systems for enterprise operations.
          Each solution is scoped, priced, and delivered within 90 days.
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {solutions.map((solution) => (
          <a href={solution.href} class="card group block">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 bg-electric-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-electric-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={solution.icon} />
              </div>
              <div>
                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-electric-400 transition-colors">
                  {solution.title}
                </h2>
              </div>
            </div>
            <p class="text-gray-500 text-sm leading-relaxed mb-5">
              {solution.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {solution.metrics.map((metric) => (
                <span class="text-xs text-electric-400 bg-electric-500/10 px-2.5 py-1 rounded">
                  {metric}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding border-t border-gray-200">
    <div class="container-narrow">
      <div class="card text-center max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Not Sure Which Solution Fits?</h2>
        <p class="text-gray-500 mb-8">
          The free blueprint audit identifies your top 3 automation opportunities
          and recommends the right starting point for your operations.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/blueprint/" class="btn-primary">Get Free Blueprint</a>
          <a href="/contact/" class="btn-secondary">Talk to Us</a>
        </div>
      </div>
    </div>
  </section>

</Base>
