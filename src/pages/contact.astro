---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact Us"
  description="Get in touch with Anomalies.in. Start a conversation about AI automation for your enterprise."
>

  <!-- PAGE HEADER -->
  <section class="section-padding bg-gray-50 border-b border-gray-200">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <div class="text-electric-400 text-sm font-semibold uppercase tracking-wider mb-4">Contact</div>
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
          Let's Talk
        </h1>
        <p class="text-xl text-gray-500 leading-relaxed">
          Tell us about your operations. We will tell you what AI can do for them.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT CONTENT -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- FORM -->
        <div class="lg:col-span-2">
          <form id="contact-form" class="space-y-6">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                  Your Name <span class="text-electric-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Rajesh Kumar"
                  class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                  Work Email <span class="text-electric-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="companyName" class="block text-sm font-medium text-gray-700 mb-2">
                Company Name <span class="text-electric-400">*</span>
              </label>
              <input
                type="text"
                id="companyName"
                name="companyName"
                required
                placeholder="Your Company Ltd."
                class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
              />
            </div>

            <div>
              <label for="role" class="block text-sm font-medium text-gray-700 mb-2">
                Your Role <span class="text-electric-400">*</span>
              </label>
              <input
                type="text"
                id="role"
                name="role"
                required
                placeholder="VP Technology / CTO / IT Manager"
                class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
              />
            </div>

            <div>
              <label for="whatsappNumber" class="block text-sm font-medium text-gray-700 mb-2">
                WhatsApp Number
              </label>
              <input
                type="tel"
                id="whatsappNumber"
                name="whatsappNumber"
                placeholder="+91 98765 43210"
                class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors"
              />
              <p class="text-xs text-gray-500 mt-1">Optional. For faster communication if you prefer WhatsApp.</p>
            </div>

            <div>
              <label for="bottleneck" class="block text-sm font-medium text-gray-700 mb-2">
                What is your biggest operational bottleneck? <span class="text-electric-400">*</span>
              </label>
              <textarea
                id="bottleneck"
                name="bottleneck"
                required
                rows="4"
                placeholder="Describe the workflow or process that is slowing your team down the most. The more specific, the better."
                class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-600 text-sm focus:outline-none focus:border-electric-500 transition-colors resize-none"
              ></textarea>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-3">
                Preferred Contact Channel <span class="text-electric-400">*</span>
              </label>
              <div class="flex gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="radio"
                    name="preferredChannel"
                    value="WhatsApp"
                    class="w-4 h-4 text-electric-500 bg-gray-50 border-gray-200 focus:ring-electric-500"
                  />
                  <span class="text-sm text-gray-700">WhatsApp</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="radio"
                    name="preferredChannel"
                    value="Email"
                    checked
                    class="w-4 h-4 text-electric-500 bg-gray-50 border-gray-200 focus:ring-electric-500"
                  />
                  <span class="text-sm text-gray-700">Email</span>
                </label>
              </div>
            </div>

            <!-- Success/Error messages -->
            <div id="form-success" class="hidden bg-accent-emerald/10 border border-accent-emerald/30 rounded-lg px-4 py-3 text-accent-emerald text-sm">
              Message sent. We will get back to you shortly.
            </div>
            <div id="form-error" class="hidden bg-red-500/10 border border-red-500/30 rounded-lg px-4 py-3 text-red-400 text-sm">
              Something went wrong. Please email us directly at yogesh@anomalies.in
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full sm:w-auto justify-center"
            >
              <span id="submit-text">Send Message</span>
              <span id="submit-loading" class="hidden">Sending...</span>
            </button>

          </form>
        </div>

        <!-- SIDEBAR -->
        <div class="space-y-8">

          <div>
            <h3 class="text-gray-900 font-semibold mb-4">Direct Channels</h3>
            <div class="space-y-4">

              <!-- Email -->
              <a
                href="mailto:yogesh@anomalies.in"
                class="flex items-center gap-3 text-gray-500 hover:text-gray-900 transition-colors group"
              >
                <div class="w-10 h-10 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center group-hover:border-electric-500/40 transition-colors flex-shrink-0">
                  <svg class="w-5 h-5 text-electric-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <div class="text-gray-900 text-sm font-medium">Email</div>
                  <div class="text-gray-500 text-sm">yogesh@anomalies.in</div>
                </div>
              </a>

              <!-- WhatsApp -->
              <a
                href="https://wa.me/919428076817?text=Hi%2C%20I%20came%20from%20anomalies.in%20and%20want%20to%20discuss%20AI%20automation."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-gray-500 hover:text-gray-900 transition-colors group"
              >
                <div class="w-10 h-10 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center group-hover:border-electric-500/40 transition-colors flex-shrink-0">
                  <svg class="w-5 h-5 text-electric-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-gray-900 text-sm font-medium">WhatsApp</div>
                  <div class="text-gray-500 text-sm">Message us directly</div>
                </div>
              </a>

              <!-- LinkedIn -->
              <a
                href="https://www.linkedin.com/company/anomalies-in/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-gray-500 hover:text-gray-900 transition-colors group"
              >
                <div class="w-10 h-10 bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center group-hover:border-electric-500/40 transition-colors flex-shrink-0">
                  <svg class="w-5 h-5 text-electric-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-gray-900 text-sm font-medium">LinkedIn</div>
                  <div class="text-gray-500 text-sm">Yogesh Tejwani</div>
                </div>
              </a>
            </div>
          </div>

          <div class="card border-electric-500/10">
            <div class="text-electric-400 text-xs font-semibold uppercase tracking-wider mb-3">Direct Response</div>
            <p class="text-gray-900 font-medium mb-1">No autoresponders. No ticketing systems.</p>
            <p class="text-gray-500 text-sm leading-relaxed">
              You get a direct, human response from Yogesh personally.
            </p>
          </div>

          <div class="card border-electric-500/10">
            <div class="text-electric-400 text-xs font-semibold uppercase tracking-wider mb-3">Not sure where to start?</div>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">
              The free blueprint is the lowest-commitment way to understand what AI can do for your operations.
            </p>
            <a href="/blueprint/" class="btn-primary text-sm w-full justify-center">
              Get Free Blueprint
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text') as HTMLElement;
  const submitLoading = document.getElementById('submit-loading') as HTMLElement;
  const successMsg = document.getElementById('form-success') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const preferredChannel = formData.get('preferredChannel') || 'Email';

    const payload = {
      name: formData.get('name'),
      email: formData.get('email'),
      companyName: formData.get('companyName'),
      role: formData.get('role'),
      whatsappNumber: formData.get('whatsappNumber') || '',
      bottleneck: formData.get('bottleneck'),
      preferredChannel,
      source: 'anomalies.in',
      stage: 'conversation_starter',
    };

    submitBtn.disabled = true;
    submitText.classList.add('hidden');
    submitLoading.classList.remove('hidden');
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    try {
      const response = await fetch(
        'https://n8n.srv1148691.hstgr.cloud/webhook/cda2f05a-4f2d-4a33-a636-583eb1cbe76f',
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }
      );

      if (response.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitText.classList.remove('hidden');
      submitLoading.classList.add('hidden');
    }
  });
</script>
