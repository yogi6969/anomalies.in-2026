---
import Base from '../layouts/Base.astro';
---

<Base
  title="About Anomalies.in"
  description="Anomalies.in is a Bangalore-based AI automation partner for Indian enterprise. We ship automation that works, not AI that impresses in demos."
>

  <!-- PAGE HEADER -->
  <section class="section-padding bg-gray-50 border-b border-gray-200">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <div class="text-electric-400 text-sm font-semibold uppercase tracking-wider mb-4">About</div>
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
          About Anomalies.in
        </h1>
        <p class="text-xl text-gray-500 leading-relaxed">
          We ship automation that works, not AI that impresses in demos.
        </p>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="flex flex-col items-start gap-6">
          <div class="w-32 h-32 bg-gray-100 border border-gray-200 rounded-2xl flex items-center justify-center">
            <svg class="w-16 h-16 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Yogesh Tejwani</h2>
            <p class="text-electric-400 text-sm font-medium mb-3">Founder, Anomalies.in</p>
            <p class="text-gray-500 text-sm mb-4">Bangalore, India</p>
            <a
              href="https://www.linkedin.com/company/anomalies-in/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-electric-400 hover:text-electric-500 text-sm font-medium transition-colors border border-electric-500/30 hover:border-electric-400/50 px-4 py-2 rounded-lg"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Building AI automation for Indian enterprise.</h3>
          <div class="space-y-4 text-gray-500 leading-relaxed">
            <p>
              I build AI automation systems for enterprise technology teams across India.
              My focus is the gap between "AI demo" and "AI in production" — the hard work
              of integrating with real systems, handling real data, and making real teams trust
              and use what you build.
            </p>
            <p>
              Anomalies.in is the vehicle for that work. We embed with VP-level technology
              leaders, identify their highest-ROI automation opportunities, and ship working
              systems within 90 days. Fixed-price. Zero lock-in. Full knowledge transfer.
            </p>
            <p>
              Based in Bangalore. Working with enterprise clients across Manufacturing, BFSI,
              Retail, Education, and Healthcare.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="section-padding bg-gray-50">
    <div class="container-narrow">
      <div class="max-w-3xl mx-auto">
        <div class="text-electric-400 text-sm font-semibold uppercase tracking-wider mb-6 text-center">Philosophy</div>
        <blockquote class="text-2xl sm:text-3xl font-semibold text-gray-900 text-center mb-16 leading-snug">
          "We ship automation that works, not AI that impresses in demos."
        </blockquote>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          {[
            {
              principle: 'Speed over Perfection',
              desc: 'A working system in production beats a perfect system in planning. We ship fast, then improve. The 90-day timeline is not a constraint — it is a discipline.',
            },
            {
              principle: 'Outcomes over Hours',
              desc: 'We are paid for results, not time. Fixed-price engagements keep us focused on what matters: your cost savings and cycle time reduction, not our billing rate.',
            },
            {
              principle: 'Partnership over Contracts',
              desc: 'A vendor-client relationship ends when the project ends. We build long-term retainer relationships because that is when we can actually help you scale.',
            },
          ].map((item) => (
            <div class="card">
              <h3 class="text-gray-900 font-semibold mb-3">{item.principle}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Technology Stack</h2>
        <p class="text-gray-500 mb-8">
          We use proven, enterprise-compatible tools. No experimental frameworks. No vendor lock-in.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {[
            { name: 'n8n', category: 'Workflow Automation' },
            { name: 'Gemini AI', category: 'Document Intelligence' },
            { name: 'Oracle ORDS', category: 'ERP Integration' },
            { name: 'WhatsApp Business API', category: 'Messaging' },
            { name: 'Microsoft Teams SDK', category: 'Enterprise Chat' },
            { name: 'Google Cloud', category: 'Infrastructure' },
          ].map((tech) => (
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
              <div class="text-gray-900 text-sm font-medium">{tech.name}</div>
              <div class="text-gray-500 text-xs mt-0.5">{tech.category}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE BELIEVE SECTION -->
  <section class="section-padding bg-gray-50 border-t border-gray-200">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">What We Believe</h2>
          <div class="space-y-5">
            {[
              {
                title: 'AI is infrastructure, not magic.',
                desc: 'The real work is integrating AI with your existing systems — not building impressive demos that fall apart when the data gets messy.',
              },
              {
                title: 'Enterprise teams deserve the same quality as startups.',
                desc: 'Indian enterprises run complex, critical operations. They deserve AI automation built to the same quality standard as any global deployment.',
              },
              {
                title: 'Knowledge transfer is non-negotiable.',
                desc: 'We are not in the business of creating dependency. We build, then we teach. Your team should be able to operate everything we deliver without us.',
              },
              {
                title: 'Numbers matter more than narratives.',
                desc: 'Every engagement should produce a measurable outcome. If we cannot tell you the exact cost saving or cycle time reduction, we have not done our job.',
              },
            ].map((belief) => (
              <div>
                <h3 class="text-gray-900 font-semibold text-sm mb-1">{belief.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{belief.desc}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="card p-8">
          <div class="text-electric-400 text-xs font-semibold uppercase tracking-wider mb-4">Based In</div>
          <div class="text-gray-900 text-xl font-semibold mb-1">Bangalore, India</div>
          <div class="text-gray-500 text-sm mb-8">Serving enterprise clients across India</div>

          <div class="text-electric-400 text-xs font-semibold uppercase tracking-wider mb-4">Sectors We Work In</div>
          <div class="flex flex-wrap gap-2">
            {['Manufacturing', 'BFSI', 'Retail', 'Education', 'Healthcare'].map((sector) => (
              <span class="px-3 py-1 bg-gray-100 border border-gray-200 rounded-full text-gray-700 text-xs">
                {sector}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-narrow text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
        Want to Work Together?
      </h2>
      <p class="text-gray-500 max-w-lg mx-auto mb-8">
        Start with the free blueprint. We will audit your workflows and tell you
        exactly what AI can do for your operations.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/blueprint/" class="btn-primary">
          Get Free Blueprint
        </a>
        <a href="/contact/" class="btn-secondary">
          Contact Us
        </a>
      </div>
    </div>
  </section>

</Base>
